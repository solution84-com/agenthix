{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@agenthix/core": ["../../core/src/index.ts"],
      "@agenthix/core/file-tools": ["../../core/src/fileTools/index.ts"]
    }
  },
  "include": ["src"]
}
