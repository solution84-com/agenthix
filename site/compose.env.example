# The site's settings for a self-hosted install.
#
# For: whoever runs a site on a machine. For the site beside hq, the host service's `agenthix install` writes it, with
# HQ_PAIRING_SECRET the same as hq's, and never replaces a value already set. For a site on another machine, copy this
# file to `site/compose.env` and fill it in. Read by site/compose.yml.

# The folder holding this site's data — an ABSOLUTE path, mounted at the same
# path inside the container. One folder per install; keep it short.
#   macOS:  /Users/<you>/.agenthix/site
#   Linux:  /home/<you>/.agenthix/site
SITE_ROOT=

# Password for the site's own database (never leaves this machine).
SITE_DB_PASSWORD=

# SECRETS_MASTER_KEY — 32-byte base64 key this site encrypts its stored hq
# credential with, so a read of the site's database alone yields nothing that
# works. This site's own key, not hq's. REQUIRED to connect to hq: without it
# the site cannot pair or join. Losing or changing it makes the stored
# credential unreadable — the default site then re-pairs from HQ_PAIRING_SECRET
# at its next start, and any other site joins again from the Fleet Console.
# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY=

# Optional: the container's name, which agents use to reach the site.
# SITE_CONTAINER_NAME=agenthix-site

# Optional: the private range agent networks are carved from, as /29 blocks.
# Change it only if it clashes with a network this machine is on. Default: the
# installations' agent range in docs/architecture/ports.md.
# AGENT_NETWORK_RANGE=

# Connecting to hq. This machine is hq's own site when both of these are set;
# it then connects at every start with no registration or approval:
#   HQ_URL            — hq's address, one this container can reach. Not
#                       localhost: inside the container that is the site itself.
#   HQ_PAIRING_SECRET — the SAME value as HQ_PAIRING_SECRET in hq/compose.env.
#                       At least 32 characters. Generate: openssl rand -hex 32
# Leave both unset for any other site, which joins from the Fleet Console's Add a site
# page, with a one-time code (docs/guide/running-agenthix/add-a-site.md).
# HQ_URL=
# HQ_PAIRING_SECRET=

# Optional: how many agent runs this site executes at once, across every
# container. Default 5. Runs beyond it wait for a slot; turns of one
# conversation always run one at a time regardless.
# AGENT_MAX_CONCURRENT_RUNS=5

# Optional: per-container limits. A container belongs to one person (or the
# project) in one storage location, and their runs in it run at the same
# time — so these are sized for several harness processes at once, up to
# AGENT_MAX_CONCURRENT_RUNS.
#   AGENT_CONTAINER_MEMORY     — `docker run --memory`. Default 8g. Any docker
#                                size (512m, 2g, a byte count).
#   AGENT_CONTAINER_PIDS_LIMIT — `--pids-limit` (counts threads). Default
#                                4096. Whole numbers.
#   AGENT_CONTAINER_CPUS       — `--cpus` ceiling, in cores; fractions
#                                allowed. Default 2.
# AGENT_CONTAINER_MEMORY=8g
# AGENT_CONTAINER_PIDS_LIMIT=4096
# AGENT_CONTAINER_CPUS=2

# Optional: how long a conversation may sit with no turn running before the
# processes it started are ended and its harness lets go of it. It stays
# resumable. Default 30 minutes.
# AGENT_SESSION_IDLE_MINUTES=30

# Optional: a proxy this site reaches model providers through. The model relay
# honours HTTPS_PROXY (a CONNECT tunnel, so provider keys stay inside TLS) and
# NO_PROXY (hosts, domain suffixes, host:port, *; localhost always goes direct).
# It never sends an http:// provider through a proxy, because the proxy would
# see the key. Credentials may be in the URL.
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=
