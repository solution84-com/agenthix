#!/bin/sh
# git credential helper for the agent container. Git calls: `<helper> get` with the
# request on stdin (protocol=/host=/path= lines). We answer only for github.com `get`;
# everything else exits silently so git falls through.
[ "$1" = "get" ] || exit 0
host=""; path=""
while IFS='=' read -r k v; do
  [ "$k" = "host" ] && host="$v"
  [ "$k" = "path" ] && path="$v"
done
[ "$host" = "github.com" ] || exit 0
# path is "owner/repo(.git)"
owner=$(printf '%s' "$path" | cut -d/ -f1)
repo=$(printf '%s' "$path" | cut -d/ -f2 | sed 's/\.git$//')
[ -n "$owner" ] && [ -n "$repo" ] || exit 0
resp=$(curl -fsS -X POST "$GIT_CRED_ENDPOINT" \
  -H "Authorization: Bearer $SITE_MCP_KEY" \
  -H "X-Agent-Handle: $AGENT_HANDLE" \
  -H "Content-Type: application/json" \
  -d "{\"owner\":\"$owner\",\"repo\":\"$repo\"}") || exit 0
# resp = {"username":"x-access-token","password":"ghs_..."}
user=$(printf '%s' "$resp" | sed -n 's/.*"username":"\([^"]*\)".*/\1/p')
pass=$(printf '%s' "$resp" | sed -n 's/.*"password":"\([^"]*\)".*/\1/p')
[ -n "$pass" ] || exit 0
printf 'username=%s\npassword=%s\n' "$user" "$pass"
