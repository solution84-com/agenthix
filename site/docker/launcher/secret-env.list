# The harness's secrets: agenthix-contain removes each of these from every
# agent command's environment, whatever the harness passed down. One name per
# line. The site's HARNESS_SECRET_ENV (src/agents/runtime/agentImage.ts) must
# name the same set; a unit test compares them.

# OpenCode's server: the password that opens its whole API, its configuration,
# and the (always empty) stand-in for auth.json.
OPENCODE_SERVER_PASSWORD
OPENCODE_CONFIG_CONTENT
OPENCODE_AUTH_CONTENT
# The key the OpenCode plugin fetches each turn's model headers with.
SITE_HARNESS_KEY
# Claude Code's credentials.
ANTHROPIC_API_KEY
ANTHROPIC_AUTH_TOKEN
CLAUDE_CODE_OAUTH_TOKEN
# Provider and search keys. None is meant to be in a harness's environment;
# removed in case one ever is.
OPENAI_API_KEY
OPENROUTER_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY
GEMINI_API_KEY
EXA_API_KEY
