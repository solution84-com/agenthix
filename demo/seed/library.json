{
  "skills": [
    {
      "name": "client-report-style",
      "description": "How Fernhill & Co writes a client report: plain words, the answer first, one page a section. Use it whenever a report or summary for a client is drafted or checked.",
      "body": "# Client report style\n\nOpen with the answer: what happened this quarter, in two sentences.\n\n- Use short sentences and everyday words. Say \"used\" rather than \"utilised\".\n- One section a page. Put the figures in a table, not in a paragraph.\n- Say plainly what did not go well, and what we will do about it.\n- End with what the client has to decide, and by when.\n\nHand the draft to a person to read before it goes anywhere.\n",
      "givenToAll": false,
      "grantedTo": [
        "writer",
        "reviewer"
      ],
      "madeBy": "sam",
      "at": -20160,
      "places": [
        "WEB"
      ]
    }
  ],
