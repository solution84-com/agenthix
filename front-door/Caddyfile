# ⚠️ The front door for this whole machine — see compose.yml before using.
# Add another application with one line per domain:
#   wiki.example.com {
#       reverse_proxy wiki:3000
#   }
# and join that application's container to the `agenthix-edge` network.

{$HQ_DOMAIN} {
	reverse_proxy hq-web:4100
}

# Uploaded files' own host (adr-0114), set as FILES_ORIGIN=https://<this name> in
# hq/compose.env too. hq-web answers only uploaded files on it. Unset, this
# block answers only a placeholder name nothing resolves, and HQ offers uploads
# as downloads only.
{$FILES_DOMAIN:files-off.localhost} {
	reverse_proxy hq-web:4100
}

# Live previews (adr-0169), when PREVIEW_DOMAIN is set in front-door/.env and
# PREVIEW_PATTERN=https://p-{id}.<that domain> in hq/compose.env: every
# p-<id>.<preview domain> goes to hq-web, which forwards it to hq's relay. Unset,
# this block answers only a placeholder name nothing resolves, and live previews
# stay off.
#
# A wildcard certificate cannot be had with the HTTP check the block above uses:
# it needs a DNS-provider challenge, which means a Caddy built with your DNS
# provider's plugin (caddy:2-alpine has none) and that provider's API token.
# With one, uncomment and fill in the tls block, e.g. for Cloudflare:
#   tls {
#       dns cloudflare {env.DNS_API_TOKEN}
#   }
# Without one, Caddy keeps retrying the certificate and live previews do not load.
*.{$PREVIEW_DOMAIN:previews-off.localhost} {
	reverse_proxy hq-web:4100
}

# A second installation on this machine, such as a public demo installed with
# `agenthix install --demo` under INSTALL_NAMESPACE=demo: only one front door can
# hold 80 and 443, so this one serves it too. Join this container to that
# installation's edge network (`demo-edge`, external, in compose.yml) and add:
#   demo.example.com, files.demo.example.com {
#       @files host files.demo.example.com
#       header @files {
#           ?Content-Disposition attachment
#           Content-Disposition inline attachment
#           X-Content-Type-Options nosniff
#           defer
#       }
#       reverse_proxy demo-hq-web:4100
#   }
# The header lines make every file on the demo's files host a download, never a
# page. The host service's own front door does the same with
# `agenthix front-door add-installation demo`.
