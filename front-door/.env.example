# The domain for hq, e.g. hq.example.com; hq's HQ_URL must then be https:// + this.
HQ_DOMAIN=

# Optional: the preview domain, e.g. preview.example.com — the same value as
# PREVIEW_DOMAIN in hq/compose.env. Needs a wildcard DNS entry (*.preview.example.com
# pointing at this machine) and a wildcard certificate, which needs a DNS-provider
# challenge: a Caddy image with your DNS provider's plugin, and its API token below.
# See the Caddyfile. Leave empty to keep previews off.
PREVIEW_DOMAIN=
DNS_API_TOKEN=
