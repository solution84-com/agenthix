# Credentials for tests that call a service outside this machine, run from a maintainer's own machine.
#
# Copy to `.env.testing` at the repository root and fill in what you need; it is gitignored. The suites that need a
# value read it from here themselves (`npm run test:models` in hq/ reads this file); a value already set in the
# environment wins. CI's suites never read it, and the apps never do: their settings are in each app's own
# `.env.server` and `compose.env`. A contributor needs none of it: without it, these tests are skipped.
#
# The keeper of every value is the team's vault: `scripts/secrets/export-to-vault.sh .env.testing` after any change,
# `scripts/secrets/import-from-vault.sh .env.testing` on a new machine (`.env.vault` says where the vault is).
# Read a value by name from a script (`grep '^NAME=' .env.testing | cut -d= -f2-`) rather than opening the file, so no
# value is shown.

# --- The lead's model checks -----------------------------------------------------------------------------------------
# Provider: OpenRouter, an API key of its own for these checks (named after them, e.g. `model-checks`), never the key
#   an HQ uses.
# Purpose: `npm run test:models` in hq/ sends the lead's context to a real model and grades the tools it calls
#   (hq/src/conversations/__modelchecks__/README.md). The key's credit limit is the cap on what a run can spend: set
#   one, monthly, a few dollars.
# Where to get it: OpenRouter › Settings › API Keys › Create key, with a credit limit. The key is shown once.
MODEL_CHECK_API_KEY=
# The vendor the key is for: openrouter (also anthropic, openai, google, or openai_compatible with MODEL_CHECK_BASE_URL).
MODEL_CHECK_PROVIDER=openrouter
# The baseline, a low-cost capable model (AGENTS.md, *Code conventions*). A large model only to diagnose a failure.
MODEL_CHECK_MODELS=~deepseek/deepseek-flash-latest
# Each check's repeats on each model.
MODEL_CHECK_RUNS=3
