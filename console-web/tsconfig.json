{
  // Type-checking only (`npm run typecheck`, which checks this and tsconfig.node.json): Vite builds the app, and
  // vitest runs the tests. This one is the browser code: DOM types, no Node types.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    // ui's source is compiled here too, and ui installs its own React types for its tests: without this, the two
    // copies clash. One copy, console-web's, as CI links it.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/__tests__"]
}
