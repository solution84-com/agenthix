# hq/compose.env — written by the host service's `agenthix install`, which makes every secret
# below and never replaces a value already set. To fill it in by hand instead,
# copy this file to hq/compose.env. Used by hq/compose.yml. Keep a copy of the
# finished file: without SECRETS_MASTER_KEY, saved keys and logins cannot be read.
#
# There is no first-admin key: while hq has no users it prints a one-time link to
# set it up in its log; `agenthix hq invite-admin` (run in the host service) prints a fresh one.

# The address people and sites use to reach hq. The browser app takes it when
# hq-web starts (ADR-0111), so changing it later needs a restart, not a rebuild.
# Must match exactly what browsers open, scheme and port included, with no
# trailing slash.
HQ_URL=http://localhost:4100

# Password for hq's own database (never leaves this machine).
HQ_DB_PASSWORD=

# HQ_PAIRING_SECRET — connects hq to its own site with no registration or
# approval. Put the SAME value in site/compose.env (with HQ_URL there set to
# hq's address). At least 32 characters. Generate: openssl rand -hex 32
# Rotate it by changing it in both files and restarting both.
HQ_PAIRING_SECRET=

# JWT_SECRET — Wasp's own session/auth cookie signing secret (required by
# Wasp whenever username+password auth is configured, as hq's is). Not read
# by hq's own code. Generate: openssl rand -hex 32
JWT_SECRET=

# SECRETS_MASTER_KEY — 32-byte base64 key for at-rest secret encryption: the
# GitHub App private key, every provider key (LLM and voice), and every stored
# model credential — a project's API key and a person's subscription login.
# REQUIRED: hq refuses to start without it. It also encrypts hq's own signing key,
# and every run needs a capability signed with that key. Losing or changing it
# makes anything already encrypted unreadable, so keep a copy.
# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY=

# ── AI Provider ───────────────────────────────────────────────────────────────
# hq runs no agents (ADR-0050) — its sites do. ANTHROPIC_API_KEY, if set, is
# stored at first boot as the org's Anthropic key (needs SECRETS_MASTER_KEY; the
# key can instead be set in the UI). hq uses it for its own model calls, such as
# a voice's sample phrase, and hands it to a site for a run that has no key of
# its own. OPENAI_API_KEY and GEMINI_API_KEY are only reported on hq's settings
# page; nothing on hq reads them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# PREVIEW_DOMAIN — turns live previews on (adr-0071). Each preview is served from
# p-<id>.<this domain>, never from HQ_URL's own host, so it needs a wildcard DNS
# entry (*.<this domain> pointing at this machine) and a wildcard certificate at
# the front door. Left empty, previews are off: an agent's start_preview is
# refused and nothing is served for a preview. It may sit under hq's own domain
# (preview.hq.example.com) or be a second domain you own (safer: the browser then
# sends none of the first domain's cookies with a preview). No scheme, no dots at
# either end. See docs/architecture/deployment.md.
PREVIEW_DOMAIN=

# FILES_ORIGIN — where uploaded files (task attachments, pictures) are served
# from, never HQ_URL's own host (adr-0114): for example
# https://files.hq.example.com, with its DNS pointing at this machine and a
# certificate at the front door. With HQ_URL on localhost it may stay empty:
# files.localhost on the same port is used. Left empty otherwise, HQ offers
# uploads only as downloads, and its settings page says so. A scheme and a host,
# perhaps with a port; nothing more.
FILES_ORIGIN=

# How many proxies stand in front of hq-web: 1 with nothing in front of it
# (the default), 2 behind one front door (this machine's own, or front-door/).
HQ_TRUSTED_PROXIES=1

# Where hq-web listens. 127.0.0.1 (default) keeps it off the network; 0.0.0.0
# opens it to the network — only do that behind a front door or on a trusted
# network.
HQ_BIND=127.0.0.1
HQ_PORT=4100
