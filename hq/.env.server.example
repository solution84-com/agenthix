# hq's server settings for development.
#
# For: a contributor running hq from source. A self-hosted hq uses hq/compose.env instead.
# Copy to `hq/.env.server` before the first run; it is gitignored. Read by `wasp start`.
# Port numbers: docs/architecture/ports.md, written from core/src/ports/ports.ts.

# --- Written for you: leave these alone ------------------------------------------------------------------------------
# hq/scripts/dev/start.sh, scripts/dev/pair.sh and hq/scripts/dev/ensure-secrets-key.sh write these at every start,
# keeping every other line. They are listed so that the file reads whole.

# The address hq's server is reached at. Written by start.sh: localhost, or the machine's address with --lan or --tailnet.
WASP_SERVER_URL=
# The address hq's web page is opened at. Written by start.sh, as above.
WASP_WEB_CLIENT_URL=
# The secret hq and its own development site share, so the site connects with no joining. Written by pair.sh,
# the same value in site/.env.server.
HQ_PAIRING_SECRET=
# The secret hq and its relay share; the relay carries the bytes of every file a browser opens (adr-0153).
# Written by pair.sh, the same value in relay/.env.server.
HQ_RELAY_SECRET=
# The address sites reach hq's relay at, in development only, where sites dial hq's server directly. Written by
# pair.sh. Never set on a deployed hq.
HQ_RELAY_LINE_URL=
# The 32-byte base64 key hq encrypts what it stores with: the GitHub App's private key, every provider key, every
# model credential, and hq's own signing key. Required: hq refuses to start without it. Written once by
# ensure-secrets-key.sh when blank, and never replaced. Losing or changing it makes everything already encrypted
# unreadable.
SECRETS_MASTER_KEY=

# --- You fill in -----------------------------------------------------------------------------------------------------

# The port hq's server listens on: hq's server port in docs/architecture/ports.md. Required.
PORT=4101

# hq's database, the hq-db service of the root docker-compose.yml. Start it with `docker compose up -d` from the
# repository root, then fill this in as
#   postgresql://<user>:<password>@127.0.0.1:<port>/<database>
# with hq-db's user, password and database from docker-compose.yml, and hq's database port from
# docs/architecture/ports.md. Required.
DATABASE_URL=

# --- Optional --------------------------------------------------------------------------------------------------------

# A known administrator after every database reset: when DEV_LOGIN_ENABLED is true and both of the others are set,
# `wasp db seed` creates this user. Leave all three blank to go through hq's own first-admin link instead. Never set
# on a deployed hq.
DEV_LOGIN_ENABLED=
DEV_LOGIN_USERNAME=
DEV_LOGIN_PASSWORD=

# Where the browser loads hq's web page from, when it isn't hq's web port on localhost. Default: that address.
# HQ_ORIGIN=

# The address pattern live previews are served at, such as https://p-{id}.preview.example.com (adr-0169). Leave it
# unset in development: live previews are then at p-<id>.preview.localhost, which browsers resolve to this machine.
# PREVIEW_PATTERN=

# Where uploaded files are served from, never hq's own address (adr-0114). Leave it unset in development: with hq on
# localhost, files.localhost on the same port is used.
# FILES_ORIGIN=

# hq's own storage: agent images, the voice cache, board templates and library skills. Default: hq/storage, which
# survives. Required on a deployed hq.
# HQ_STORAGE_ROOT=

# hq's bundled assets: templates, library and presets. Default: hq/assets.
# HQ_ASSETS_ROOT=

# Settings that belong to the site, not hq — SITE_ROOT, AGENT_CONTAINER_* and the rest: site/.env.server.example.
