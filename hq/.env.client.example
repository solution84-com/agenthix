# hq's web page settings for development.
#
# For: a contributor running hq from source with `npx wasp start`. Copy to `hq/.env.client` before the first run; it
# is gitignored. hq/scripts/dev/start.sh (the VS Code task [dev:hq] Start) writes this whole file at every start, so
# with it there is nothing to copy. Port numbers: docs/architecture/ports.md.

# The port the web page's development server (Vite) listens on: hq's web port.
PORT=4100
# hq's server, as the browser reaches it: hq's server port. Built into the page, so a change needs a restart.
REACT_APP_API_URL=http://localhost:4101
# The web page's own address.
REACT_APP_CLIENT_URL=http://localhost:4100
