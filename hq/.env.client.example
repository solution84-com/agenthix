# hq — Client Environment Variables (dev)
# Copy to .env.client and fill in values.
# Used by: wasp start (local development)
# Note: This file is fully overwritten on every run of:
#         site/scripts/dev/start.sh                  (localhost — host browser only)
#         site/scripts/dev/start.sh --lan            (auto-detected LAN IP)
#         site/scripts/dev/start.sh --lan-ip <ip>    (explicit IP — used by parent monorepo orchestrator)
#       Only copy this example manually if you're running `wasp start` directly
#       without the start script.

# ── Ports ─────────────────────────────────────────────────────────────────────
# PORT — Wasp/Vite client dev server port.
# REACT_APP_API_URL — Wasp bakes this into the React bundle at build time.
# Must match PORT in .env.server. Default (without this file) is localhost:3001.
PORT=4100
REACT_APP_API_URL=http://localhost:4101
REACT_APP_CLIENT_URL=http://localhost:4100
