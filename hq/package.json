{
  "name": "agenthix_hq",
  "private": true,
  "license": "Elastic-2.0",
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "scripts": {
    "agenthix:start": "./scripts/start.sh",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.wasp.json",
    "check:bundle": "node scripts/check/bundle.mjs",
    "test:models": "vitest run -c vitest.models.config.ts --reporter verbose",
    "test:integration": "node scripts/test/with-test-db.mjs --clean-env --workers=4 npx vitest run -c vitest.integration.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "typecheck:guide": "tsc -p e2e/guide/tsconfig.json",
    "guide:console-web": "npm --prefix ../console-web run build",
    "guide:screenshots": "rm -rf e2e/guide/.captures && node scripts/guide/check-names.mjs && npm run typecheck:guide && npm run guide:console-web && node scripts/guide/with-guide-db.mjs sh -c \"npx playwright test --project guide-fresh --workers 1 && node e2e/fixtures/seed-guide-data.mjs && npx playwright test --project guide\"",
    "guide:compare": "node scripts/guide/compare.mjs",
    "guide:pin": "node scripts/guide/pin-screenshots.mjs",
    "sigstore:refresh": "node scripts/sigstore/refresh-trust-root.mjs"
  },
  "dependencies": {
    "@agenthix/core": "file:../core",
    "@agenthix/ui": "file:../ui",
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.134",
    "@ai-sdk/openai": "^3.0.41",
    "@dicebear/core": "^9.4.3",
    "@dicebear/glass": "^9.4.3",
    "@dicebear/icons": "^9.4.3",
    "@dicebear/identicon": "^9.4.3",
    "@dicebear/initials": "^9.4.3",
    "@dicebear/lorelei": "^9.4.3",
    "@dicebear/lorelei-neutral": "^9.4.3",
    "@dicebear/notionists": "^9.4.3",
    "@dicebear/notionists-neutral": "^9.4.3",
    "@dicebear/open-peeps": "^9.4.3",
    "@dicebear/pixel-art": "^9.4.3",
    "@dicebear/pixel-art-neutral": "^9.4.3",
    "@dicebear/rings": "^9.4.3",
    "@dicebear/shapes": "^9.4.3",
    "@dicebear/thumbs": "^9.4.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/tokenizers": "^0.2.0",
    "@inworld/tts": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sigstore/bundle": "^5.0.0",
    "@sigstore/core": "^4.0.1",
    "@sigstore/protobuf-specs": "^0.5.2",
    "@sigstore/verify": "^4.1.2",
    "@tiptap/extension-placeholder": "^3.22.2",
    "@tiptap/markdown": "^3.22.2",
    "@tiptap/react": "^3.22.2",
    "@tiptap/starter-kit": "^3.22.2",
    "ai": "^6.0.116",
    "bcrypt": "^6.0.0",
    "http-proxy": "^1.18.1",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^1.7.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-easy-crop": "^6.2.5",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-router": "^8.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "ws": "^8.20.0",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sigstore/tuf": "^5.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/http-proxy": "^1.17.15",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@wasp.sh/spec": "file:.wasp/spec",
    "@wasp.sh/wasp-cli": "0.25.0",
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prisma": "5.19.1",
    "tailwindcss": "^4.1.3",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.22.3"
  }
}
