{
  "name": "AI Startup",
  "description": "Full development lifecycle — frontend, backend, QA, PM, and docs.",
  "tags": [
    "software",
    "startup",
    "fullstack"
  ],
  "teams": [
    {
      "name": "Engineering",
      "purpose": "Build and maintain the product",
      "agents": [
        "frontend",
        "backend",
        "qa",
        "docs"
      ]
    },
    {
      "name": "Product",
      "purpose": "Product strategy, roadmap, and documentation",
      "agents": [
        "pm"
      ]
    }
  ],
  "projects": [
    {
      "name": "Product Development",
      "description": "Main product sprint work",
      "defaultAgentHandle": "pm",
      "types": [
        {
          "name": "Story",
          "icon": "task",
          "columns": [
            {
              "name": "Backlog",
              "state": "BACKLOG"
            },
            {
              "name": "To do",
              "state": "TODO"
            },
            {
              "name": "In progress",
              "state": "IN_PROGRESS",
              "colour": "accent",
              "default": true
            },
            {
              "name": "In review",
              "state": "IN_PROGRESS",
              "colour": "warning"
            },
            {
              "name": "Done",
              "state": "DONE",
              "colour": "success"
            }
          ]
        }
      ]
    },
    {
      "name": "Documentation",
      "description": "Docs, guides, and changelogs",
      "defaultAgentHandle": "docs"
    },
    {
      "name": "Internal Ops",
      "description": "Bugs, incidents, maintenance",
      "types": [
        {
          "name": "Bug",
          "icon": "bug",
          "columns": [
            {
              "name": "Reported",
              "state": "BACKLOG"
            },
            {
              "name": "Triaged",
              "state": "TODO"
            },
            {
              "name": "Fixing",
              "state": "IN_PROGRESS",
              "colour": "accent"
            },
            {
              "name": "Verified",
              "state": "DONE",
              "colour": "success"
            }
          ]
        },
        {
          "name": "Feature request",
          "icon": "feature",
          "columns": [
            {
              "name": "Submitted",
              "state": "BACKLOG"
            },
            {
              "name": "Accepted",
              "state": "TODO"
            },
            {
              "name": "Building",
              "state": "IN_PROGRESS",
              "colour": "accent",
              "default": true
            },
            {
              "name": "Testing",
              "state": "IN_PROGRESS",
              "colour": "warning"
            },
            {
              "name": "Shipped",
              "state": "DONE",
              "colour": "success"
            }
          ]
        }
      ],
      "fields": [
        {
          "name": "Severity",
          "type": "SINGLE_SELECT",
          "options": [
            {
              "name": "Low"
            },
            {
              "name": "Medium",
              "colour": "warning"
            },
            {
              "name": "High",
              "colour": "danger"
            }
          ]
        }
      ]
    }
  ]
}
